# ============================================================
#  Pipeline Post-Venta — .gitignore
# ============================================================

# --- Secretos / entorno -------------------------------------
# El .env REAL nunca se versiona. El .env.example SI (es la plantilla).
.env
.env.*
!.env.example

# Credenciales reales de n8n (la guía .example si se versiona)
CREDENCIALES.md
cookies.txt

# --- Backups -------------------------------------------------
# Dumps de BD + credenciales/workflows exportados por backup.ps1
backups/

# --- Temporales del sistema ---------------------------------
# Lock de Word al tener un .docx abierto
~$*
*.tmp

# --- Memoria de proyecto (engram) ---------------------------
# Solo si NO querés versionar la memoria. Si la querés versionar,
# borrá esta línea (ver protocolo engram).
.engram/

# --- Python (scripts de analisis de experimentos) ------------
__pycache__/
*.pyc
.venv/
.venv*/
.pytest_cache/

# --- Frontend (dashboard-web) --------------------------------
node_modules/
dist/

# --- Claude Code --------------------------------------------
# Worktrees, settings locales y todo lo de .claude: nunca se versiona.
.claude/

# --- OS ------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---- credenciales: NUNCA versionar (repositorio publico) ----
# Inventario de credenciales del proyecto y volcado de credentials_entity
# de n8n. El segundo trae los blobs cifrados; el primero, la clave con la
# que se descifran. Juntos exponen la API key de OpenAI.
env.example.env
.env.example.pre-merge
restore_credentials.sql
