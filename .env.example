# Plantilla de variables de entorno. Copiar a .env y completar con valores propios.
# El .env real NO se versiona.

# Clave de cifrado de n8n. Obligatoria: n8n la usa para cifrar las credenciales
# almacenadas. Si cambia, las credenciales existentes dejan de poder descifrarse.
# Generar una nueva con: openssl rand -base64 24
N8N_ENCRYPTION_KEY=

# Contrasena del usuario de PostgreSQL
POSTGRES_PASSWORD=

# Contrasena del panel de n8n (usuario: admin)
N8N_PASSWORD=

# Contrasena del panel de Grafana (usuario: admin)
GRAFANA_PASSWORD=

# URL publica HTTPS para los webhooks (ej. ngrok). Sin esto, el trigger de
# Telegram no se puede registrar. Ver comentario en docker-compose.yml.
WEBHOOK_URL=

# ---- Dashboard API (Fase 2) ---------------------------------
# Secreto de firma de los JWT del dashboard (access 2h + refresh 7d).
# Generar uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
DASHBOARD_JWT_SECRET=

# Clave Fernet (base64, 32 bytes) para cifrar las credenciales de canales.
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DASHBOARD_ENC_KEY=

# Secreto compartido con el workflow n8n de vinculacion (header X-N8N-SECRET).
DASHBOARD_N8N_SECRET=

# Base de datos para correr la API desde el HOST (dev/Vite).
# En Docker el servicio usa internamente postgres:5432 (ver docker-compose.yml).
DASHBOARD_DATABASE_URL=postgresql+psycopg://n8n_user:n8n_pass@localhost:5433/ecommerce_tesis
