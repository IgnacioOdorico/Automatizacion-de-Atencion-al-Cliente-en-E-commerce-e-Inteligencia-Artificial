        "query": "SELECT\n  p.id AS product_id,\n  p.sku,\n  p.name AS product_name,\n  p.price,\n  p.stock AS stock_actual,\n  p.stock_min,\n  $1::int AS cantidad_solicitada,\n  CASE\n    WHEN p.stock >= $1::int THEN true\n    ELSE false\n  END AS stock_disponible\nFROM products p\nWHERE p.sku = $2;",
        "options": {
          "queryReplacement": "={{ [$('Webhook - Recibir Orden').item.json.body.quantity, $('Webhook - Recibir Orden').item.json.body.product_sku] }}"
