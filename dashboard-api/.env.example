# Plantilla de variables de entorno del dashboard-api.
# Copiar a dashboard-api/.env SOLO para correr la API desde el host (dev).
# En Docker las variables las inyecta docker-compose.yml.

# Conexion a PostgreSQL. Desde el HOST es localhost:5433 (el 5432 lo ocupa
# un Postgres nativo). En Docker es postgres:5432.
DATABASE_URL=postgresql+psycopg://n8n_user:n8n_pass@localhost:5433/ecommerce_tesis

# Secreto de firma de los JWT del dashboard.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
DASHBOARD_JWT_SECRET=

# Clave Fernet (base64, 32 bytes) para cifrar credenciales de canales.
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DASHBOARD_ENC_KEY=

# Secreto compartido con el workflow n8n de vinculacion (header X-N8N-SECRET).
DASHBOARD_N8N_SECRET=

# Origenes permitidos por CORS (whitelist explicita, nunca *).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080